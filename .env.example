# Database (PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-xyz-123.region.neon.tech/neondb?sslmode=require"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dashboard_db

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication Secrets (Generate secure 64-char strings in production)
JWT_ACCESS_SECRET=dashboard_jwt_access_super_secret_key_2026_change_in_prod
JWT_REFRESH_SECRET=dashboard_jwt_refresh_super_secret_key_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Client Environment (Vite)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
